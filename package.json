{
  "name": "codexlike",
  "version": "1.0.0",
  "description": "CodexLike：本地 AI coding agent 桌面工作台（类似 Codex Desktop 的功能平替）",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @codexlike/agent-core run build && concurrently -n agent-core,ui,desktop -c yellow,cyan,green \"pnpm --filter @codexlike/agent-core run build:watch\" \"pnpm --filter @codexlike/ui run dev\" \"pnpm --filter @codexlike/desktop run dev\"",
    "build": "pnpm -r run build",
    "dist": "pnpm build && pnpm --filter @codexlike/desktop run dist",
    "typecheck": "pnpm --filter @codexlike/agent-core run build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e",
    "test:e2e:acceptance": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:acceptance",
    "test:e2e:commands": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:commands",
    "test:e2e:compact": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:compact",
    "test:e2e:changes": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:changes",
    "test:e2e:interrupt": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:interrupt",
    "test:e2e:worktree": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:worktree",
    "test:e2e:packaged": "pnpm --filter @codexlike/desktop run test:e2e:packaged",
    "prepare": "husky",
    "test:e2e:projects": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:projects",
    "check:adr": "node scripts/check-adr.mjs",
    "test:e2e:all": "pnpm build && pnpm --filter @codexlike/desktop run test:e2e:all"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
