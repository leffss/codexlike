    "@codexlike/agent-core": "workspace:*",
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
