{
  "name": "@codexlike/desktop",
  "version": "1.0.0",
  "description": "CodexLike 桌面宿主：Electron 主进程、类型化 IPC 桥与本地配置存储（safeStorage 加密）。",
  "type": "module",
  "private": true,
  "main": "./dist/main.cjs",
  "exports": {
    "./ipc": {
      "types": "./src/shared/ipc.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "pnpm run predist && electron-builder --win --projectDir .dist-vendor",
    "predist": "node scripts/dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:acceptance": "node e2e/acceptance.mjs",
    "test:e2e:commands": "node e2e/commands.mjs",
    "test:e2e:browser": "node e2e/browser.mjs",
    "test:e2e:approvals": "node e2e/approvals.mjs",
    "test:e2e:changes": "node e2e/changes.mjs",
    "test:e2e:interrupt": "node e2e/interrupt.mjs",
    "test:e2e:compact": "node e2e/compact.mjs",
    "test:e2e:worktree": "node e2e/worktree.mjs",
    "test:e2e:mcp": "node e2e/mcp.mjs",
    "test:e2e:subagents": "node e2e/subagents.mjs",
    "test:e2e:packaged": "node e2e/packaged.mjs",
    "test:e2e:projects": "node e2e/projects-sidebar.mjs"
  },
  "devDependencies": {
    "@codexlike/agent-core": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
