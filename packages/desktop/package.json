{
  "name": "@codexlike/desktop",
  "version": "1.0.0",
  "description": "CodexLike 桌面宿主：Electron 主进程、类型化 IPC 桥与本地配置存储（safeStorage 加密）。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/main.cjs",
  "exports": {
    "./ipc": {
      "types": "./src/shared/ipc.ts",
      "default": "./src/shared/ipc.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "smoke:pty": "node scripts/pty-smoke.mjs",
    "dist": "pnpm run predist && electron-builder --win --projectDir .dist-vendor",
    "predist": "node scripts/dist.mjs",
    "typecheck": "pnpm --filter @codexlike/agent-core run build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @codexlike/agent-core run build && vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:acceptance": "node e2e/acceptance.mjs",
