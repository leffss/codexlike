{
  "name": "@codexlike/desktop",
  "version": "1.0.0",
  "description": "CodexLike 桌面宿主：Electron 主进程、类型化 IPC 桥与本地配置存储（safeStorage 加密）。",
  "type": "module",
  "private": true,
  "main": "./dist/main.cjs",
  "exports": {
    "./ipc": {
      "types": "./src/shared/ipc.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "pnpm run predist && electron-builder --win --projectDir .dist-vendor",
    "predist": "node scripts/dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:acceptance": "node e2e/acceptance.mjs",
    "test:e2e:commands": "node e2e/commands.mjs",
    "test:e2e:skills": "node e2e/skills.mjs",
    "test:e2e:browser": "node e2e/browser.mjs",
    "test:e2e:approvals": "node e2e/approvals.mjs",
    "test:e2e:interactions": "node e2e/interactions.mjs",
    "test:e2e:changes": "node e2e/changes.mjs",
    "test:e2e:interrupt": "node e2e/interrupt.mjs",
    "test:e2e:compact": "node e2e/compact.mjs",
    "test:e2e:worktree": "node e2e/worktree.mjs",
    "test:e2e:mcp": "node e2e/mcp.mjs",
    "test:e2e:subagents": "node e2e/subagents.mjs",
    "test:e2e:subagent-thinking": "node e2e/subagent-thinking.mjs",
    "test:e2e:packaged": "node e2e/packaged.mjs",
    "test:e2e:projects": "node e2e/projects-sidebar.mjs",
    "test:e2e:persistence": "node e2e/persistent-workbench.mjs",
    "test:e2e:exit": "node e2e/exit-recovery.mjs",
    "test:e2e:live-sessions": "node e2e/live-sessions.mjs",
    "test:e2e:sidebar": "node e2e/sidebar-archive.mjs",
    "test:e2e:search": "node e2e/session-search.mjs",
    "test:e2e:membership": "node e2e/membership.mjs",
    "test:e2e:theme": "node e2e/theme.mjs",
    "test:e2e:thinking": "node e2e/thinking.mjs",
    "test:e2e:message-order": "node e2e/message-order.mjs",
    "test:e2e:width": "node e2e/width-tiers.mjs",
    "test:e2e:scroll": "node e2e/scroll-following.mjs",
    "test:e2e:entries": "node e2e/entry-consistency.mjs",
    "test:e2e:all": "node e2e/smoke.mjs && node e2e/acceptance.mjs && node e2e/commands.mjs && node e2e/browser.mjs && node e2e/approvals.mjs && node e2e/interactions.mjs && node e2e/changes.mjs && node e2e/interrupt.mjs && node e2e/compact.mjs && node e2e/worktree.mjs && node e2e/mcp.mjs && node e2e/subagents.mjs && node e2e/projects-sidebar.mjs && node e2e/sidebar-archive.mjs && node e2e/membership.mjs && node e2e/session-search.mjs && node e2e/theme.mjs && node e2e/skills.mjs && node e2e/thinking.mjs && node e2e/subagent-thinking.mjs && node e2e/message-order.mjs && node e2e/live-sessions.mjs && node e2e/persistent-workbench.mjs && node e2e/exit-recovery.mjs && node e2e/entry-consistency.mjs && node e2e/width-tiers.mjs && node e2e/scroll-following.mjs"
  },
  "devDependencies": {
    "@codexlike/agent-core": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
