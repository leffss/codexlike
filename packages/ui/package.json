{
  "name": "@codexlike/ui",
  "version": "1.0.0",
  "description": "CodexLike 渲染进程 UI：React + Vite + Tailwind，全中文界面。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "pnpm --filter @codexlike/agent-core run build && tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "pnpm --filter @codexlike/agent-core run build && vitest run"
  },
  "dependencies": {
    "@codexlike/agent-core": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@codexlike/desktop": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
